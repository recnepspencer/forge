{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "rootDir": "./react",
    "outDir": "./pkg/react",
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "./react/**/*.ts",
    "./react/**/*.tsx",
    "./react/**/*.d.ts"
  ]
}
