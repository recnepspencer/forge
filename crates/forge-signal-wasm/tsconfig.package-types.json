{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "ESNext.Disposable"
    ]
  },
  "include": [
    "./package/types-smoke.ts",
    "./package/forms-phase-one-types-smoke.ts",
    "./package/resource-types-smoke.ts"
  ]
}
