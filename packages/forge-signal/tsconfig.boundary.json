{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/init.ts",
    "src/internal/codec.ts",
    "src/internal/merge-reports.ts",
    "src/surface/*.ts",
    "src/wasm.d.ts"
  ]
}
