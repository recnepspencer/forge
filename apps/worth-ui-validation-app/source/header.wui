app ValidationHeaderApp {
    theme ValidationHeaderTheme
    workspace ValidationHeaderWorkspace
}

workspace ValidationHeaderWorkspace {
    shell {
        topbar ValidationHeaderTopbar
        rail ValidationHeaderRail
        page_host ValidationHeaderPageHost
        inspector ValidationHeaderInspector
        status ValidationHeaderStatus
        overlays [ValidationCommandPaletteOverlay]
        toasts ValidationHeaderToasts
    }

    pages [HeaderProofPage]
}

page HeaderProofPage {
    title "Implement milestone 4 hot reload"
    runtime HeaderProofRuntime
    layout HeaderProofLayout
    content HeaderProofContent
}

runtime HeaderProofRuntime {}

surface worth.surface.preview.button.proof {
    component worth.component.button
    label "Submit"
    icon worth.icon.action.plus
    variant primary
    size large
    width 280
    background_color "#2f7de1"
    hover_background_color "#3f8ff5"
    pressed_background_color "#ffffff"
    foreground_color "#f7f1e8"
    pressed_foreground_color "#2f7de1"
    icon_color "#f7f1e8"
    pressed_icon_color "#2f7de1"
    icon_size 32
    icon_stroke_width "1.6"
    text_size 15
    content_gap 4
    border_width 0
    pressed_border_color "#2f7de1"
    pressed_border_width 2
    border_radius 14
    container_align center
    container_padding 24
    interaction_kind submit
    interaction_id worth.interaction.button.submit
    interaction_payload "authored submit payload"
    interaction_target worth.surface.preview.button.proof
    interaction_readiness disabled
}

surface worth.surface.preview.primitive.proof {
    component worth.component.primitive_proof
    primitive_align center
    primitive_padding validation.density.primitive.padding.wide_shallow
    primitive_radius validation.density.primitive.radius
    primitive_background "#2f7de1"
    primitive_foreground "#ffffff"
    primitive_interaction submit
    primitive_cursor pointer
    primitive_focus focusable
    primitive_disabled false
    primitive_selected false
    interaction_kind click
    interaction_id worth.interaction.primitive.submit
    interaction_payload "manual.batch1.submit"
    interaction_target worth.surface.preview.primitive.proof
    interaction_readiness enabled
    event_cursor pointer
    event_hit_area padded_bounds
    event_hit_slop validation.density.primitive.event.hit_slop.default
    event_containment contain
    event_capture none
    primitive_motion transition
    primitive_motion_target primitive_background
    primitive_motion_duration validation.density.primitive.motion.fast
    primitive_motion_easing standard
    appearance_rest_background "#2f7de1"
    appearance_rest_foreground "#ffffff"
    appearance_rest_border_color "transparent"
    appearance_rest_border_width validation.density.primitive.border.none
    appearance_rest_radius validation.density.primitive.radius
    appearance_rest_opacity "1"
    appearance_rest_focus_ring_color validation.theme.header.menu.hover
    appearance_rest_focus_ring_width validation.density.primitive.border.none
    appearance_rest_icon_color "#ffffff"
    appearance_rest_text_color "#ffffff"
    appearance_rest_typography validation.appearance.header.font_size
    appearance_hover_background "#3f8ff5"
    appearance_pressed_background "#ffffff"
    appearance_pressed_foreground "#2f7de1"
    appearance_pressed_border_color "#2f7de1"
    appearance_pressed_border_width validation.density.primitive.border.default
    appearance_pressed_icon_color "#2f7de1"
    appearance_pressed_text_color "#2f7de1"
    appearance_focus_focus_ring_color "transparent"
    appearance_focus_focus_ring_width validation.density.primitive.border.none
    appearance_disabled_background "#252a31"
    appearance_disabled_foreground "#a5acb7"
    appearance_disabled_border_color "transparent"
    appearance_disabled_border_width validation.density.primitive.border.none
    appearance_disabled_icon_color "#a5acb7"
    appearance_disabled_text_color "#a5acb7"
    appearance_disabled_opacity "1"
    appearance_selected_background "#2f7de1"
    content_kind inline
    content_order "text,icon"
    content_text "Send"
    content_icon worth.icon.action.check
    content_text_size validation.density.primitive.content.text.default
    content_icon_size validation.density.primitive.content.icon.large
    content_icon_stroke validation.density.primitive.content.icon.stroke.default
    content_accessibility_name "Submit"
    flow_kind inline
    flow_gap validation.density.primitive.flow.gap.compact
    flow_padding validation.density.primitive.flow.padding.compact
    flow_align center
    flow_cross_align center
    flow_fit hug
    flow_fill none
}

surface worth.surface.preview.primitive.inner {
    component worth.component.primitive_proof
    primitive_align center
    primitive_padding validation.density.primitive.padding.wide_shallow
    primitive_radius validation.density.primitive.radius
    primitive_background "#2f7de1"
    primitive_foreground "#ffffff"
    primitive_interaction submit
    primitive_cursor pointer
    primitive_focus focusable
    primitive_disabled true
    primitive_selected false
    interaction_kind submit
    interaction_id worth.interaction.primitive.inner
    interaction_payload "inner.submit.payload"
    interaction_target worth.surface.preview.primitive.inner
    interaction_readiness disabled
    event_cursor pointer
    event_hit_area explicit_hit_slop
    event_hit_slop validation.density.primitive.event.hit_slop.compact
    event_containment contain
    event_capture press_drag
    primitive_motion transition
    primitive_motion_target primitive_background
    primitive_motion_duration validation.density.primitive.motion.fast
    primitive_motion_easing standard
    appearance_rest_background "#2f7de1"
    appearance_rest_foreground "#ffffff"
    appearance_rest_border_color "transparent"
    appearance_rest_border_width validation.density.primitive.border.none
    appearance_rest_radius validation.density.primitive.radius
    appearance_rest_opacity "1"
    appearance_rest_focus_ring_color validation.theme.header.menu.hover
    appearance_rest_focus_ring_width validation.density.primitive.border.none
    appearance_rest_icon_color "#ffffff"
    appearance_rest_text_color "#ffffff"
    appearance_rest_typography validation.appearance.header.font_size
    appearance_hover_background "#3f8ff5"
    appearance_pressed_background "#ffffff"
    appearance_pressed_foreground "#2f7de1"
    appearance_pressed_border_color "#2f7de1"
    appearance_pressed_border_width validation.density.primitive.border.default
    appearance_pressed_icon_color "#2f7de1"
    appearance_pressed_text_color "#2f7de1"
    appearance_focus_focus_ring_color "transparent"
    appearance_focus_focus_ring_width validation.density.primitive.border.none
    appearance_disabled_background "#252a31"
    appearance_disabled_foreground "#a5acb7"
    appearance_disabled_border_color "transparent"
    appearance_disabled_border_width validation.density.primitive.border.none
    appearance_disabled_icon_color "#a5acb7"
    appearance_disabled_text_color "#a5acb7"
    appearance_disabled_opacity "1"
    appearance_selected_background "#2f7de1"
    content_kind inline
    content_order "text,icon"
    content_text "Send"
    content_icon worth.icon.action.check
    content_text_size validation.density.primitive.content.text.default
    content_icon_size validation.density.primitive.content.icon.large
    content_icon_stroke validation.density.primitive.content.icon.stroke.default
    content_accessibility_name "Submit"
    flow_kind inline
    flow_gap validation.density.primitive.flow.gap.compact
    flow_padding validation.density.primitive.flow.padding.compact
    flow_align center
    flow_cross_align center
    flow_fit hug
    flow_fill none
}

layout HeaderProofLayout {
    column gap(0) padding(0) {
        row height fill {
            slot button_proof
        }
    }
}

content HeaderProofContent {
    button_proof -> worth.surface.preview.primitive.proof
}

appearance ValidationHeaderTheme {}
