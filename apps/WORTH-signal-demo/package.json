{
  "name": "worth-signals-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "refresh:signal": "powershell -NoProfile -Command \"Set-Location ../../packages/worth-signal; npm run build:wasm\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/worth-signals-demo/",
    "test:demo-docs": "node --test tests/demo_documentation_contract.test.mjs",
    "test:landing": "node --experimental-strip-types --test tests/landing_mobile_carousel.test.mjs",
    "test:demo5": "node --test tests/demo_five_concurrency.test.mjs",
    "test:demo6": "node --experimental-wasm-modules --test tests/demo_six_aspect_merge.test.mjs tests/demo_six_code_evidence.test.mjs tests/worker_bundle_integrity.test.mjs",
    "test:packed-wasm": "node ../../scripts/wasm/verify-worth-signals-demo-packed.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "worth-signals-wasm": "file:../../crates/worth-signal-wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-wasm": "^3.6.0"
  }
}
